typedef TSetupMessageID = U16

global WIZARDFORM: TWizardForm
global UNINSTALLPROGRESSFORM: TUninstallProgressForm

external function Exec(Filename: String, Params: String, WorkingDir: String, ShowCmd: Integer, Wait: TExecWait, *ResultCode: Integer): Boolean
