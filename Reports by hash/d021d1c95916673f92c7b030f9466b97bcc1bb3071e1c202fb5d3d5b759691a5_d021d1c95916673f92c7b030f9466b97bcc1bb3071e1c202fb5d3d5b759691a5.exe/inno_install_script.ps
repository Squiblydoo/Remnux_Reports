  function __pascal NextButton(): TNewButton
end;

external class TRadioButton
  property Checked: Boolean
end;

external class TControl
  property Enabled: Boolean
end;

external class TButton
  property Caption: String
end;

typedef AnyMethod = ProcPtr()
