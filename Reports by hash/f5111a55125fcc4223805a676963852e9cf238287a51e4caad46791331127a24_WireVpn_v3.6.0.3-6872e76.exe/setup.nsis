Function func_804    ; Page 1, Show
  ShowWindow $HWNDPARENT 0
  Call Initialize_____Plugins
  File "$PLUGINSDIR\System.dll"
  SetDetailsPrint lastused
  Push "user32::SetWindowPos(i$HWNDPARENT,i0,i0,i0,i0,i0,i0x0002)"
  CallInstDLL "$PLUGINSDIR\System.dll" "Call"
  Call Initialize_____Plugins
  File "$PLUGINSDIR\setupdll.dll"
  SetDetailsPrint lastused
  Push "text"
  Push "edit_choose_url"
  Push "SEdit"
  CallInstDLL "$PLUGINSDIR\setupdll.dll" /NOUNLOAD "GetControlProperties"
  Pop $V0
  StrCpy $INSTDIR "$V0\WireVpnPc"
  Call Initialize_____Plugins
  File "$PLUGINSDIR\setupdll.dll"
  SetDetailsPrint lastused
  Push 3
  Push "curSel"
  Push "tab_main"
  Push "STabCtrl"
  CallInstDLL "$PLUGINSDIR\setupdll.dll" /NOUNLOAD "SetControlProperties"
  Call Initialize_____Plugins
  File "$PLUGINSDIR\setupdll.dll"
  SetDetailsPrint lastused
  Push "pg_installing"
  CallInstDLL "$PLUGINSDIR\setupdll.dll" /NOUNLOAD "BindingProgress"
FunctionEnd

Function func_833
label_833:
  Call Initialize_____Plugins
  File "$PLUGINSDIR\System.dll"
  SetDetailsPrint lastused
  Push "kernel32::CreateMutexA(i 0, i 0, t $\"MyMutex_Install$\") i .R1 ?e"
  CallInstDLL "$PLUGINSDIR\System.dll" "Call"
  Pop $R0
  Call Initialize_____Plugins
  File "$PLUGINSDIR\System.dll"
  SetDetailsPrint lastused
  Push "kernel32::CloseHandle(i R1) i.s"
  CallInstDLL "$PLUGINSDIR\System.dll" "Call"
  StrCmp $R0 0 label_848 ; If: $R0 != 0
    MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "°²×°³ÌÐòÒÑ¾­ÔËÐÐ£¡" IDRETRY label_833
    Quit
    Goto label_856
  ; EndIf
label_848:
  Call Initialize_____Plugins
  File "$PLUGINSDIR\System.dll"
  SetDetailsPrint lastused
  Push "kernel32::CreateMutexA(i 0, i 0, t $\"MyMutex_Install$\") i .R1 ?e"
  CallInstDLL "$PLUGINSDIR\System.dll" "Call"
  Pop $R0
  StrCmp $R0 0 label_856
  Quit
label_856:
FunctionEnd

Function .onInit
  Call :label_859
  Goto label_892
label_859:
  StrCmp $CMDLINE "" 0 label_862 ; If: $CMDLINE == ""
    Push ""
    Return
  ; EndIf
label_862:
  Push $V0
  Push $V1
  Push $V2
  Push $V3
  StrLen $V1 $CMDLINE
  StrCpy $V2 2
  StrCpy $V3 $CMDLINE 1
  StrCmp $V3 "$\"" label_871
  StrCpy $V3 " "
  ; Do
label_871:
    IntCmp $V2 $V1 label_875 0 label_875
    StrCpy $V0 $CMDLINE 1 $V2
    IntOp $V2 $V2 + 1
  StrCmp $V3 $V0 0 label_871 ; LoopUntil: $V3 != $V0
label_875:
  IntCmp $V2 $V1 label_880 0 label_880 ; While: $V2 >= $V1
    StrCpy $V0 $CMDLINE 1 $V2
    StrCmp $V0 " " 0 label_880
    IntOp $V2 $V2 + 1
  ; EndWhile
label_880:
  StrCpy $V0 $CMDLINE "" $V2
label_881:
  StrCpy $V1 $V0 1 -1
  StrCmp $V1 " " 0 label_885 ; While: $V1 == " "
    StrCpy $V0 $V0 -1
  ; EndWhile
label_885:
  Pop $V3
  Pop $V2
  Pop $V1
  Push $V0
  Exch
  Pop $V0
  Return
label_892:
  Pop $R0
  Push $R0
  Push "/S"
  Call :label_897
  Goto label_986
label_897:
  Push $V1
  Exch
  Pop $V1
  Exch
  Push $V0
  Exch
  Pop $V0
  Exch
  Push $V2
  Push $V3
  Push $V4
  Push $V5
  Push $V6
  Push $V7
  ClearErrors
  StrCpy $V2 $V1 "" 1
  StrCpy $V1 $V1 1
  StrLen $V3 $V2
  StrCpy $V7 0
label_916:
  StrCpy $V4 -1
  StrCpy $V6 ""
label_918:
  IntOp $V4 $V4 + 1
  StrCpy $V5 $V0 1 $V4
  StrCmp "$V5$V7" 0 label_973 ; While: "$V5$V7" != 0
    StrCmp $V5 "" label_960
    StrCmp $V5 "$\"" 0 label_929
    StrCmp $V6 "" 0 label_926
    StrCpy $V6 "$\""
    Goto label_918
label_926:
    StrCmp $V6 "$\"" 0 label_929
    StrCpy $V6 ""
    Goto label_918
label_929:
    StrCmp $V5 "'" 0 label_936
    StrCmp $V6 "" 0 label_933
    StrCpy $V6 "'"
    Goto label_918
label_933:
    StrCmp $V6 "'" 0 label_936
    StrCpy $V6 ""
    Goto label_918
label_936:
    StrCmp $V5 "`" 0 label_943
    StrCmp $V6 "" 0 label_940
    StrCpy $V6 "`"
    Goto label_918
label_940:
    StrCmp $V6 "`" 0 label_943
    StrCpy $V6 ""
    Goto label_918
label_943:
    StrCmp $V6 "$\"" label_918
    StrCmp $V6 "'" label_918
    StrCmp $V6 "`" label_918
    StrCmp $V5 $V1 0 label_918
    StrCmp $V7 0 label_948 label_960
label_948:
    IntOp $V4 $V4 + 1
    StrCpy $V5 $V0 $V3 $V4
    StrCmp $V5 "" label_973
    StrCmp $V5 $V2 0 label_918
    IntOp $V4 $V4 + $V3
    StrCpy $V0 $V0 "" $V4
label_954:
    StrCpy $V4 $V0 1
    StrCmp $V4 " " 0 label_958 ; While: $V4 == " "
      StrCpy $V0 $V0 "" 1
    ; EndWhile
label_958:
    StrCpy $V7 1
  ; EndWhile
label_960:
  StrCpy $V0 $V0 $V4
label_961:
  StrCpy $V4 $V0 1 -1
  StrCmp $V4 " " 0 label_965 ; While: $V4 == " "
    StrCpy $V0 $V0 -1
  ; EndWhile
label_965:
  StrCpy $V3 $V0 1
  StrCpy $V4 $V0 1 -1
  StrCmp $V3 $V4 0 label_975 ; If: $V3 == $V4
    StrCmp $V3 "$\"" label_971
    StrCmp $V3 "'" label_971
    StrCmp $V3 "`" 0 label_975
label_971:
    StrCpy $V0 $V0 -1 1
    Goto label_975
label_973:
    SetErrors
    StrCpy $V0 ""
  ; EndIf
label_975:
  Pop $V7
  Pop $V6
  Pop $V5
  Pop $V4
  Pop $V3
  Pop $V2
  Pop $V1
  Push $V0
  Exch
  Pop $V0
  Return
label_986:
  Pop $R1
  IfErrors label_990 ; If: not Errors
    StrCpy $R0 "$R0 /NCRC"
    SetSilent normal
  ; EndIf
label_990:
  Call Initialize_____Plugins
  SetDetailsPrint lastused
  SetOutPath $PLUGINSDIR
  StrCpy $OUTDIR $OUTDIR
  SetOverwrite ifnewer
  File "setupdll.dll"
  SetOutPath $OUTDIR
  Call func_833
FunctionEnd

